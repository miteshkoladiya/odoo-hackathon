# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/dayflow-hrms

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Email Configuration (for email verification and password reset)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@dayflow.com

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Company Settings
DEFAULT_COMPANY_NAME=Odoo India

# Leave Balance Defaults
DEFAULT_PAID_LEAVE=24
DEFAULT_SICK_LEAVE=7
DEFAULT_UNPAID_LEAVE=999

# Working Hours Configuration
DEFAULT_WORKING_HOURS=9
DEFAULT_BREAK_HOURS=1
DEFAULT_WORKING_DAYS=5